target Cpp

reactor Model {
  state x: int = 0
  state y: int = 0
  logical action alpha_action: void
  logical action beta_action: void

  reaction(startup) -> alpha_action {=
    x = 0;
    y = 0;
    alpha_action.schedule(1ms);
  =}

  reaction(alpha_action) -> beta_action {=
    x = y;
    beta_action.schedule(1ms);
  =}

  reaction(beta_action) -> alpha_action {=
    y = x;
    alpha_action.schedule(1ms);
  =}
}

main reactor {
  model = new Model()
}
