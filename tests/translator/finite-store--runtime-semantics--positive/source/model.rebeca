// Benchmark: finite-store--runtime-semantics--positive
// Exercises two-variable finite-store runtime semantics with a
// cross-variable assignment through the real RMC, translation,
// LF compilation, and bounded native runtime route. Formal evidence
// combines source-capability obligations with shared Store metadata.
reactiveclass TwoStateController(10) {
    statevars {
        int x;
        int y;
    }

    TwoStateController() {
        x = 1;
        y = 2;
        self.tick() after(1);
    }

    msgsrv tick() {
        y = x;
        self.tick() after(1);
    }
}

main {
    TwoStateController controller():();
}
