target Cpp

reactor Initializer {
  state x: int = 0
  state y: int = 0
  state z: int = 0
  logical action begin_action: void

  reaction(startup) -> begin_action {=
    x = 1;
    y = 2;
    z = 3;
    begin_action.schedule(1ms);
  =}

  reaction(begin_action) -> begin_action {=
    x = y;
    y = z;
    z = x;
    begin_action.schedule(1ms);
  =}
}

main reactor {
  initializer = new Initializer()
}
