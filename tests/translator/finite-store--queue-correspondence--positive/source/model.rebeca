// Benchmark: finite-store--queue-correspondence--positive
// Exercises two indistinguishable recurring pending occurrences of the same
// local message server at the same logical delay. Each tick reschedules one
// successor occurrence, preserving the duplicate queue-correspondence setting
// while avoiding an intentionally terminal/deadlocked model.
reactiveclass Controller(10) {
statevars {
int x;
}

Controller() {
    x = 0;
    self.tick() after(1);
    self.tick() after(1);
}

msgsrv tick() {
    x = 0;
    self.tick() after(1);
}
}

main {
Controller controller():();
}
