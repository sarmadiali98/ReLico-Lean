// Benchmark: core--runtime-semantics--positive
// Exercises recurring assignment and delayed self-send through the complete
// generated LF/C++ runtime route. Runtime success is a bounded observation.
reactiveclass Controller(10) {
statevars {
int x;
}

Controller() {
x = 0;
self.tick() after(1);
}

msgsrv tick() {
x = 1;
self.tick() after(1);
}
}

main {
Controller controller():();
}
