target Cpp

reactor Seed {
  state x: int = 0
  state y: int = 0
  logical action run_action: void

  reaction(startup) -> run_action {=
    x = 7;
    y = 3;
    run_action.schedule(1ms);
  =}

  reaction(run_action) -> run_action {=
    x = y;
    run_action.schedule(1ms);
  =}
}

main reactor {
  seed = new Seed()
}
