// Benchmark: core--trace-execution--positive
// Exercises an assignment trace through the complete generated LF/C++ route.
// Runtime success is a bounded observation.
reactiveclass Controller(10) {
statevars {
int x;
}

Controller() {
x = 5;
self.tick() after(1);
}

msgsrv tick() {
x = 7;
self.tick() after(1);
}
}

main {
Controller controller():();
}
