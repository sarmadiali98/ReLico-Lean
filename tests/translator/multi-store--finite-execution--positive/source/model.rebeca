// Benchmark: multi-store--finite-execution--positive
// A multi-store source exercising finite execution: a three-step cycle, so any bounded window is a finite execution that repeats exactly.
reactiveclass Runner(10) {
    statevars {
        int x;
    }

    Runner() {
        x = 0;
        self.one() after(1);
    }

    msgsrv one() {
        x = 1;
        self.two() after(1);
    }

    msgsrv two() {
        x = 2;
        self.three() after(1);
    }

    msgsrv three() {
        x = 3;
        self.one() after(1);
    }
}

main {
    Runner runner():();
}
