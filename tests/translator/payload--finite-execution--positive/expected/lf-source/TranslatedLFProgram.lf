target Cpp

reactor Rotor {
  state x: int = 0
  state y: int = 0
  state z: int = 0
  logical action turn_action: void

  reaction(startup) -> turn_action {=
    x = 1;
    y = 2;
    z = 3;
    turn_action.schedule(1ms);
  =}

  reaction(turn_action) -> turn_action {=
    x = y;
    y = z;
    z = x;
    turn_action.schedule(1ms);
  =}
}

main reactor {
  rotor = new Rotor()
}
