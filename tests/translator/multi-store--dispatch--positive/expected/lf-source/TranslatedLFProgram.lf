target Cpp

reactor Dispatcher {
  state x: int = 0
  state y: int = 0
  logical action first_action: void
  logical action second_action: void

  reaction(startup) -> first_action {=
    x = 1;
    y = 2;
    first_action.schedule(1ms);
  =}

  reaction(first_action) -> second_action {=
    x = y;
    second_action.schedule(1ms);
  =}

  reaction(second_action) -> first_action {=
    y = x;
    first_action.schedule(1ms);
  =}
}

main reactor {
  dispatcher = new Dispatcher()
}
