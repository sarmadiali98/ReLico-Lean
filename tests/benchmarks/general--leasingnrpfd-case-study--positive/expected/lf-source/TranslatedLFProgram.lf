  reaction(pingNRP_action) -> pingNRP_responseToUp2, pingNRP_responseToNodeTarget12, pingNRPToUp, pingNRPToDown {=
    auto pingNRP_action_payload = *pingNRP_action.get();
    auto switchNode = pingNRP_action_payload.switchNode;
    auto senderNode = pingNRP_action_payload.senderNode;
    auto NRP = pingNRP_action_payload.NRP;
    if ((!failed)) { if ((terminal && (NRP == id))) { prevWhich = which; which = (senderNode == primary); if ((switchNode <= 99)) { pingNRP_responseToUp2.set(Switch_pingNRP_response_action_Args{id, which, prevWhich}); } else { pingNRP_responseToNodeTarget12.set(Node_pingNRP_response_action_Args{id, which, prevWhich}); } } else { if ((switchNode > id)) { pingNRPToUp.set(Switch_pingNRP_action_Args{id, senderNode, NRP}); } else { pingNRPToDown.set(Switch_pingNRP_action_Args{id, senderNode, NRP}); } } } else {}
  =}

