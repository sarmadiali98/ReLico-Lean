  struct Node_new_NRPBack_action_Args { int mid; int prim; int mNRP_network; int mNRP_switch_id; };
  struct Node_heartBeat_action_Args { int networkId; int senderid; };
  struct Switch_new_NRPBack_action_Args { int senderNode; int prim; int mNRP_network; int mNRP_switch_id; };
  struct Switch_new_NRP_action_Args { int senderNode; int prim; int mNRP_network; int mNRP_switch_id; };
