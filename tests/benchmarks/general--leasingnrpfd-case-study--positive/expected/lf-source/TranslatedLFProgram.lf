    if ((!failed)) { if ((terminal && (senderNode <= 99))) { heartBeatToNodeTarget1.set(Node_heartBeat_action_Args{networkId, id}); } else { if ((senderNode > id)) { heartBeatToUp.set(Switch_heartBeat_action_Args{networkId, id}); } else { heartBeatToDown.set(Switch_heartBeat_action_Args{networkId, id}); } } } else {}
  =}

