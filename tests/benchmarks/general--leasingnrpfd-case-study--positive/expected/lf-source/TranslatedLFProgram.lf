  reaction(startup) -> switchFail_action1, switchFail_action2 {=
    mynetworkId = networkId;
    primary = 0;
    id = myid;
    primaryPinged = false;
    terminal = endSwitch;
    amINRP = false;
    failed = false;
    which = true;
    if ((myFailTime == 2500)) { switchFail_action1.schedule(2500ms); } else { if ((myFailTime == 5000)) { switchFail_action2.schedule(5000ms); } else {} }
  =}

  reaction(switchFail_action1) {=
    failed = true;
    amINRP = false;
  =}

  reaction(switchFail_action2) {=
    failed = true;
    amINRP = false;
  =}

  reaction(pingNRP_response_action) -> pingNRP_responseToNodeTarget11, pingNRP_responseToUp1, pingNRP_responseToDown {=
    auto pingNRP_response_action_payload = *pingNRP_response_action.get();
    auto senderNode = pingNRP_response_action_payload.senderNode;
    auto w = pingNRP_response_action_payload.w;
    auto pw = pingNRP_response_action_payload.pw;
    if ((!failed)) { if ((terminal && (senderNode <= 99))) { pingNRP_responseToNodeTarget11.set(Node_pingNRP_response_action_Args{id, w, pw}); } else { if ((senderNode > id)) { pingNRP_responseToUp1.set(Switch_pingNRP_response_action_Args{id, w, pw}); } else { pingNRP_responseToDown.set(Switch_pingNRP_response_action_Args{id, w, pw}); } } } else {}
  =}

