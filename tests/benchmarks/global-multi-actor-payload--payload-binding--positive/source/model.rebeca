// Benchmark: global-multi-actor-payload--payload-binding--positive
// Formerly global-multi-actor-payload--payload-binding--negative, re-polarized: the restriction it encoded is
// obsolete under the current verified fragment. See README.
reactiveclass Sender(100) {
    knownrebecs{
        Receiver receiver0;
    }

    Sender() {
        self.sendMessage(1);
        self.keepAlive() after(1);
    }

    @priority(1)
    msgsrv sendMessage(int data){
        receiver0.receiveMessage(data + 1);
    }

    msgsrv keepAlive() {
        self.keepAlive() after(1);
    }
}

reactiveclass Receiver(100) {
    @priority(1)
    msgsrv receiveMessage(int data){
        // Process data
    }
}

main {
    Sender sender0(receiver0):();
    Receiver receiver0():();
}
