// Benchmark: general--aspin-case-study--positive
// Source: examples.zip/ReLico-main/ASPIN.rebeca. The archive contains no
// ASPIN property file; this fixture checks translation and runtime behavior.
reactiveclass Manager(10) {
    knownrebecs {
        Router r00;
        Router r10;
        Router r20;
        Router r30;
        Router r01;
        Router r11;
        Router r21;
        Router r31;
        Router r02;
        Router r12;
        Router r22;
        Router r32;
        Router r03;
        Router r13;
        Router r23;
        Router r33;
    }

    Manager() {
    }

    msgsrv reset(int unit) {
        r01.reStart(0) after(700);
    }
}

reactiveclass Router(10) {
    knownrebecs {
        Manager manager;
        Router N;
        Router E;
        Router S;
        Router W;
    }

    statevars {
        int bufSize;
        int maxTime;
        int recieved;

        int bufNum0;
        int bufNum1;
        int bufNum2;
        int bufNum3;
        boolean full0;
        boolean full1;
        boolean full2;
        boolean full3;
        boolean enable0;
        boolean enable1;
        boolean enable2;
        boolean enable3;
        boolean outMutex0;
        boolean outMutex1;
        boolean outMutex2;
        boolean outMutex3;

        int Xid;
        int Yid;
        boolean deadlineViolation;
    }

    Router(int X, int Y) {
        Xid = X;
        Yid = Y;

        bufSize = 2;
        maxTime = 250;
        recieved = 0;
        deadlineViolation = false;

        enable0 = true;
        enable1 = true;
        enable2 = true;
        enable3 = true;
        outMutex0 = true;
        outMutex1 = true;
        outMutex2 = true;
        outMutex3 = true;
        bufNum0 = 0;
        bufNum1 = 0;
        bufNum2 = 0;
        bufNum3 = 0;
        full0 = false;
        full1 = false;
        full2 = false;
        full3 = false;

        if (X == 0 && Y == 0) {
            self.reqSend(2, 3, 1, 5) after(10);
        }

        if (X == 0 && Y == 1) {
            self.reStart(0) after(700);
        }

        if (X == 2 && Y == 3) {
            self.checkRecieved() after(250);
        }
    }

    msgsrv reqSend(int Xtarget, int Ytarget, int directionS, int packId) {
        boolean enabled = false;
        if (directionS == 0) {
            enabled = enable0;
        } else if (directionS == 1) {
            enabled = enable1;
        } else if (directionS == 2) {
            enabled = enable2;
        } else {
            enabled = enable3;
        }

        if (enabled == true) {
            boolean sent = false;

            if (Xtarget > Xid) {
                if (outMutex1 == true) {
                    E.give_Ack(Xtarget, Ytarget, directionS, 3, 3, packId) after(26);
                    outMutex1 = false;
                    if (directionS == 0) {
                        enable0 = false;
                    } else if (directionS == 1) {
                        enable1 = false;
                    } else if (directionS == 2) {
                        enable2 = false;
                    } else {
                        enable3 = false;
                    }
                    sent = true;
                } else {
                    self.reqSend(Xtarget, Ytarget, directionS, packId) after(1);
                }
            } else if (Xtarget < Xid) {
                if (outMutex3 == true) {
                    W.give_Ack(Xtarget, Ytarget, directionS, 1, 1, packId) after(26);
                    outMutex3 = false;
                    if (directionS == 0) {
                        enable0 = false;
                    } else if (directionS == 1) {
                        enable1 = false;
                    } else if (directionS == 2) {
                        enable2 = false;
                    } else {
                        enable3 = false;
                    }
                    sent = true;
                } else {
                    self.reqSend(Xtarget, Ytarget, directionS, packId) after(1);
                }
            } else if (Ytarget > Yid) {
                if (outMutex2 == true) {
                    S.give_Ack(Xtarget, Ytarget, directionS, 0, 0, packId) after(26);
                    outMutex2 = false;
                    if (directionS == 0) {
                        enable0 = false;
                    } else if (directionS == 1) {
                        enable1 = false;
                    } else if (directionS == 2) {
                        enable2 = false;
                    } else {
                        enable3 = false;
                    }
                    sent = true;
                } else {
                    self.reqSend(Xtarget, Ytarget, directionS, packId) after(1);
                }
            } else if (Ytarget < Yid) {
                if (outMutex0 == true) {
                    N.give_Ack(Xtarget, Ytarget, directionS, 2, 2, packId) after(26);
                    outMutex0 = false;
                    if (directionS == 0) {
                        enable0 = false;
                    } else if (directionS == 1) {
                        enable1 = false;
                    } else if (directionS == 2) {
                        enable2 = false;
                    } else {
                        enable3 = false;
                    }
                    sent = true;
                } else {
                    self.reqSend(Xtarget, Ytarget, directionS, packId) after(1);
                }
            }

            if (sent == true) {
                if (directionS == 0) {
                    bufNum0 = bufNum0 + 1;
                    if (bufNum0 == bufSize) {
                        full0 = true;
                    }
                } else if (directionS == 1) {
                    bufNum1 = bufNum1 + 1;
                    if (bufNum1 == bufSize) {
                        full1 = true;
                    }
                } else if (directionS == 2) {
                    bufNum2 = bufNum2 + 1;
                    if (bufNum2 == bufSize) {
                        full2 = true;
                    }
                } else {
                    bufNum3 = bufNum3 + 1;
                    if (bufNum3 == bufSize) {
                        full3 = true;
                    }
                }
            }
        } else {
            self.reqSend(Xtarget, Ytarget, directionS, packId) after(1);
        }
    }

    msgsrv get_Ack(int directionS, int senderDirection) {
        if (directionS == 0) {
            enable0 = true;
            bufNum0 = bufNum0 - 1;
            full0 = false;
        } else if (directionS == 1) {
            enable1 = true;
            bufNum1 = bufNum1 - 1;
            full1 = false;
        } else if (directionS == 2) {
            enable2 = true;
            bufNum2 = bufNum2 - 1;
            full2 = false;
        } else {
            enable3 = true;
            bufNum3 = bufNum3 - 1;
            full3 = false;
        }

        if (senderDirection == 0) {
            outMutex0 = true;
        } else if (senderDirection == 1) {
            outMutex1 = true;
        } else if (senderDirection == 2) {
            outMutex2 = true;
        } else {
            outMutex3 = true;
        }
    }

    msgsrv give_Ack(int Xtarget, int Ytarget, int directionS, int directionD, int msgSender, int packId) {
        boolean bufferFull = false;
        if (directionD == 0) {
            bufferFull = full0;
        } else if (directionD == 1) {
            bufferFull = full1;
        } else if (directionD == 2) {
            bufferFull = full2;
        } else {
            bufferFull = full3;
        }

        if (!(Xtarget == Xid && Ytarget == Yid)) {
            if (bufferFull) {
                self.give_Ack(Xtarget, Ytarget, directionS, directionD, msgSender, packId) after(2);
            } else {
                self.reqSend(Xtarget, Ytarget, directionD, packId);

                if (msgSender == 0) {
                    N.get_Ack(directionS, 2);
                } else if (msgSender == 1) {
                    E.get_Ack(directionS, 3);
                } else if (msgSender == 2) {
                    S.get_Ack(directionS, 0);
                } else {
                    W.get_Ack(directionS, 1);
                }
            }
        } else {
            recieved = recieved + 1;

            if (msgSender == 0) {
                N.get_Ack(directionS, 2);
            } else if (msgSender == 1) {
                E.get_Ack(directionS, 3);
            } else if (msgSender == 2) {
                S.get_Ack(directionS, 0);
            } else {
                W.get_Ack(directionS, 1);
            }
        }
    }

    msgsrv reStart(int unit) {
        manager.reset(0);
    }

    msgsrv checkPoint() {
        deadlineViolation = true;
    }

    msgsrv checkRecieved() {
        if (recieved == 0) {
            self.checkPoint();
        }
    }
}

main {
    Manager m(r00,r10,r20,r30,r01,r11,r21,r31,r02,r12,r22,r32,r03,r13,r23,r33):();

    Router r00(m,r03,r10,r01,r30):(0,0);
    Router r10(m,r13,r20,r11,r00):(1,0);
    Router r20(m,r23,r30,r21,r10):(2,0);
    Router r30(m,r33,r00,r31,r20):(3,0);

    Router r01(m,r00,r11,r02,r31):(0,1);
    Router r11(m,r10,r21,r12,r01):(1,1);
    Router r21(m,r20,r31,r22,r11):(2,1);
    Router r31(m,r30,r01,r32,r21):(3,1);

    Router r02(m,r01,r12,r03,r32):(0,2);
    Router r12(m,r11,r22,r13,r02):(1,2);
    Router r22(m,r21,r32,r23,r12):(2,2);
    Router r32(m,r31,r02,r33,r22):(3,2);

    Router r03(m,r02,r13,r00,r33):(0,3);
    Router r13(m,r12,r23,r10,r03):(1,3);
    Router r23(m,r22,r33,r20,r13):(2,3);
    Router r33(m,r32,r03,r30,r23):(3,3);
}
