// Benchmark: finite-store--trace-execution--positive
// Exercises a cross-variable finite-store execution trace through
// the real RMC, translation, LF compilation, and bounded runtime route.
// Formal evidence is provided by the existing StoreTrace theorems.
reactiveclass TwoStateController(10) {
    statevars {
        int x;
        int y;
    }

    TwoStateController() {
        x = 1;
        y = 2;
        self.tick() after(1);
    }

    msgsrv tick() {
        y = x;
        self.tick() after(1);
    }
}

main {
    TwoStateController controller():();
}
