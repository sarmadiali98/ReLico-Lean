reactiveclass ResourceManager(5)
{
    knownrebecs
    {
        AppMaster am1;
        AppMaster am2;
    }

    statevars
    {
        int FREE;
        int BUSY;
        int appMaster1;
        int appMaster2;
        int m_queue_misses;
        int m_update_miss;
        int m_job_complete;
        int fifo0;
        int fifo1;
        int fifo2;
        int DEFAULT_DEADLINE;
        int QUEUE_SIZE;
    }

    ResourceManager()
    {
        FREE = 1;
        BUSY = 0;
        appMaster1 = FREE;
        appMaster2 = FREE;
        m_queue_misses = 0;
        m_update_miss = 0;
        m_job_complete = 0;
        DEFAULT_DEADLINE = 3;
        fifo0 = DEFAULT_DEADLINE;
        fifo1 = DEFAULT_DEADLINE;
        fifo2 = DEFAULT_DEADLINE;
        QUEUE_SIZE = 3;
        self.checkQueue();
    }

    msgsrv checkQueue()
    {
        m_queue_misses = 0;
        m_update_miss = 0;
        m_job_complete = 0;
        if(appMaster1 == FREE)
        {
            appMaster1 = BUSY;
            am1.runJob(fifo0, 1);
            fifo0 = fifo1;
            fifo1 = fifo2;
            fifo2 = DEFAULT_DEADLINE;
        }
        if(appMaster2 == FREE)
        {
            appMaster2 = BUSY;
            am2.runJob(fifo0, 2);
            fifo0 = fifo1;
            fifo1 = fifo2;
            fifo2 = DEFAULT_DEADLINE;
        }

        fifo0 = fifo0 - 1;
        if(fifo0 == 0)
        {
            m_queue_misses = m_queue_misses + 1;
            fifo0 = fifo1;
            fifo1 = fifo2;
            fifo2 = DEFAULT_DEADLINE;
        }

        fifo1 = fifo1 - 1;
        if(fifo1 == 0)
        {
            m_queue_misses = m_queue_misses + 1;
            fifo1 = fifo2;
            fifo2 = DEFAULT_DEADLINE;
        }

        fifo2 = fifo2 - 1;
        if(fifo2 == 0)
        {
            m_queue_misses = m_queue_misses + 1;
            fifo2 = DEFAULT_DEADLINE;
        }

        self.checkQueue() after(1);
    }

    msgsrv update(boolean deadline_miss, int masterId)
    {
        m_queue_misses = 0;
        m_update_miss = 0;
        m_job_complete = 0;
        if(deadline_miss == true)
        {
            m_update_miss = 1;
        }
        else
        {
            m_job_complete = 1;
        }
        if(masterId == 1)
        {
            appMaster1 = FREE;
        }
        else
        {
            appMaster2 = FREE;
        }
    }
}

reactiveclass AppMaster(5)
{
    knownrebecs
    {
        ResourceManager rm;
    }

    statevars
    {
        int doneJobs;
    }

    AppMaster()
    {
        doneJobs = 0;
    }

    msgsrv runJob(int dline, int masterId)
    {
        int completion = 2;
        boolean deadline_miss = false;
        if(completion > dline)
        {
            deadline_miss = true;
            rm.update(deadline_miss, masterId) after(1);
        }
        else
        {
            deadline_miss = false;
            rm.update(deadline_miss, masterId) after(2);
            doneJobs = doneJobs + 1;
            if(doneJobs > 5)
                doneJobs = 1;
        }
    }
}

main
{
    ResourceManager rm(am1, am2):();
    AppMaster am1(rm):();
    AppMaster am2(rm):();
}
