// Benchmark: bound-payload--dispatch--negative
// Exercises an RMC-valid bound-payload dispatch whose message-server
// parameter is intentionally outside the current ReLico v0 parser bridge.
reactiveclass Controller(10) {
    statevars {
        int x;
    }

    Controller() {
        x = 0;
        self.dispatch(1) after(1);
    }

    msgsrv dispatch(int payload) {
        x = payload;
        self.dispatch(payload) after(1);
    }
}

main {
    Controller controller():();
}
