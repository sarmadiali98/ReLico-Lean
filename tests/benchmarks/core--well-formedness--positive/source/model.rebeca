// Benchmark: core--well-formedness--positive
// Positive well-formedness source mirroring the implemented Lean validModel.
// It uses valid names, a matching actor/class, integer/state-variable
// expressions, assignment, and a declared delayed recurring self-send.
reactiveclass Controller(10) {
    statevars {
        int x;
    }

    Controller() {
        x = 0;
        self.tick() after(1);
    }

    msgsrv tick() {
        x = x;
        self.tick() after(1);
    }
}

main {
    Controller controller():();
}
