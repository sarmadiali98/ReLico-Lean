// Benchmark: general--message-circulation--positive
// A DTR-fragment redesign of examples2 A_First_Example, whose original
// form overflows the model checker's queue; see README for the redesign.
reactiveclass Node(4) {
    knownrebecs {
        Node next;
    }
    statevars {
        int id;
        int seen;
    }
    Node(int _id) {
        id = _id;
        seen = 0;
        self.sendMsg(1);
    }
    msgsrv sendMsg(int msg) {
        next.rcvMsg(msg);
    }
    msgsrv rcvMsg(int msg) {
        seen = msg;
        next.sendMsg(msg) after(1);
    }
}
main {
    Node node0(node1):(0);
    Node node1(node0):(1);
}
