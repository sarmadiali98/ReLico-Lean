target Cpp

reactor Stepper {
  state x: int = 0
  state y: int = 0
  logical action step_action: void

  reaction(startup) -> step_action {=
    x = 1;
    y = 2;
    step_action.schedule(1ms);
  =}

  reaction(step_action) -> step_action {=
    x = y;
    y = x;
    step_action.schedule(1ms);
  =}
}

main reactor {
  stepper = new Stepper()
}
