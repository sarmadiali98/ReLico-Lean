target Cpp

reactor Checker {
  input completeToChkFromSink: int
  state violation: int = 0
  logical action complete_action: int

  reaction(startup) {=
    violation = 0;
  =}

  reaction(complete_action) {=
    auto v = *complete_action.get();
    if ((v != 1)) { violation = 1; } else {}
  =}

  reaction(completeToChkFromSink) {=
    auto v = *completeToChkFromSink.get();
    if ((v != 1)) { violation = 1; } else {}
  =}
}

reactor Sink {
  input inToSinkFromNode: int
  output completeToChk: int
  logical action in_action: int

  reaction(in_action) -> completeToChk {=
    auto v = *in_action.get();
    completeToChk.set(v);
  =}

  reaction(inToSinkFromNode) -> completeToChk {=
    auto v = *inToSinkFromNode.get();
    completeToChk.set(v);
  =}
}

reactor Node {
  input inToNodeFromSource: int
  output inToSink: int
  logical action in_action: int
  logical action forward_action: int

  reaction(in_action) -> forward_action {=
    auto v = *in_action.get();
    forward_action.schedule(v, 10ms);
  =}

  reaction(inToNodeFromSource) -> forward_action {=
    auto v = *inToNodeFromSource.get();
    forward_action.schedule(v, 10ms);
  =}

  reaction(forward_action) -> inToSink {=
    auto v = *forward_action.get();
    inToSink.set(v);
  =}
}

reactor Source {
  output inToNode: int
  logical action start_action: void

  reaction(startup) -> start_action {=
    start_action.schedule(0ms);
  =}

  reaction(start_action) -> inToNode {=
    inToNode.set(1);
  =}
}

reactor KeepAlive {
  state phase: int = 0
  logical action tick_action1: void
  logical action tick_action2: void

  reaction(startup) -> tick_action1 {=
    phase = 0;
    tick_action1.schedule(100ms);
  =}

  reaction(tick_action1) -> tick_action2 {=
    if ((phase == 0)) { phase = 1; } else { phase = 0; }
    tick_action2.schedule(100ms);
  =}

  reaction(tick_action2) -> tick_action2 {=
    if ((phase == 0)) { phase = 1; } else { phase = 0; }
    tick_action2.schedule(100ms);
  =}
}

main reactor {
  source = new Source()
  node = new Node()
  sink = new Sink()
  chk = new Checker()
  ka = new KeepAlive()
  source.inToNode -> node.inToNodeFromSource after 0 msec
  node.inToSink -> sink.inToSinkFromNode after 0 msec
  sink.completeToChk -> chk.completeToChkFromSink after 0 msec
}
