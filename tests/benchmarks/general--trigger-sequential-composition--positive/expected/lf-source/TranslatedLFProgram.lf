target Cpp

reactor Node(_isfirst: bool = false, _islast: bool = false, _id: int = 0) {
  input rcvMsgToNextFromNode0: int
  input rcvMsgToNextFromNode1: int
  input rcvMsgToNextFromNode2: int
  input rcvMsgToNextFromNode3: int
  output rcvMsgToNext: int
  state isfirst: bool = false
  state islast: bool = false
  state id: int = 0
  logical action sendMsg_action1: int
  logical action sendMsg_action2: int
  logical action sendMsg_action3: int
  logical action rcvMsg_action: int

  reaction(startup) -> sendMsg_action1 {=
    isfirst = _isfirst;
    islast = _islast;
    id = _id;
    if (isfirst) { sendMsg_action1.schedule(1, 0ms); } else {}
  =}

  reaction(sendMsg_action1) -> rcvMsgToNext {=
    auto msg = *sendMsg_action1.get();
    rcvMsgToNext.set(msg);
  =}

  reaction(sendMsg_action2) -> rcvMsgToNext {=
    auto msg = *sendMsg_action2.get();
    rcvMsgToNext.set(msg);
  =}

  reaction(sendMsg_action3) -> rcvMsgToNext {=
    auto msg = *sendMsg_action3.get();
    rcvMsgToNext.set(msg);
  =}

  reaction(rcvMsg_action) -> sendMsg_action2, sendMsg_action3 {=
    auto msg = *rcvMsg_action.get();
    if (islast) { sendMsg_action2.schedule(1, 0ms); } else { sendMsg_action3.schedule(1, 0ms); }
  =}

  reaction(rcvMsgToNextFromNode0) -> sendMsg_action2, sendMsg_action3 {=
    auto msg = *rcvMsgToNextFromNode0.get();
    if (islast) { sendMsg_action2.schedule(1, 0ms); } else { sendMsg_action3.schedule(1, 0ms); }
  =}

  reaction(rcvMsgToNextFromNode1) -> sendMsg_action2, sendMsg_action3 {=
    auto msg = *rcvMsgToNextFromNode1.get();
    if (islast) { sendMsg_action2.schedule(1, 0ms); } else { sendMsg_action3.schedule(1, 0ms); }
  =}

  reaction(rcvMsgToNextFromNode2) -> sendMsg_action2, sendMsg_action3 {=
    auto msg = *rcvMsgToNextFromNode2.get();
    if (islast) { sendMsg_action2.schedule(1, 0ms); } else { sendMsg_action3.schedule(1, 0ms); }
  =}

  reaction(rcvMsgToNextFromNode3) -> sendMsg_action2, sendMsg_action3 {=
    auto msg = *rcvMsgToNextFromNode3.get();
    if (islast) { sendMsg_action2.schedule(1, 0ms); } else { sendMsg_action3.schedule(1, 0ms); }
  =}
}

main reactor {
  node0 = new Node(_isfirst=true, _islast=false, _id=0)
  node1 = new Node(_isfirst=false, _islast=false, _id=1)
  node2 = new Node(_isfirst=false, _islast=false, _id=2)
  node3 = new Node(_isfirst=false, _islast=true, _id=3)
  node0.rcvMsgToNext -> node1.rcvMsgToNextFromNode0 after 0 msec
  node1.rcvMsgToNext -> node2.rcvMsgToNextFromNode1 after 0 msec
  node2.rcvMsgToNext -> node3.rcvMsgToNextFromNode2 after 0 msec
  node3.rcvMsgToNext -> node3.rcvMsgToNextFromNode3 after 0 msec
}
