// Benchmark: global-multi-actor-payload--external-send-statement--positive
// Formerly global-multi-actor-payload--external-send-statement--negative, re-polarized: the restriction it encoded is
// obsolete under the current verified fragment. See README.
reactiveclass Sender(100) {
    knownrebecs {
        Sender receiver0;
    }

    Sender() {
        self.sendMessage(1);
        self.keepAlive() after(1);
    }

    @priority(1)
    msgsrv sendMessage(int data){
        receiver0.receiveMessage(data);
    }

    msgsrv keepAlive() {
        self.keepAlive() after(1);
    }

    @priority(1)
    msgsrv receiveMessage(int data){
        // Self-delivered payload; no further action.
    }
}

main {
    Sender sender0(sender0):();
}
