// Benchmark: multi-store-payload--priority-selection--positive
// A multi-store-payload source: two ranked message servers armed together, each owning its own state variable.
reactiveclass Selector(10) {
    statevars {
        int x;
        int y;
    }

    Selector() {
        x = 0;
        y = 0;
        self.high() after(1);
        self.low() after(1);
    }

    @priority(1)
    msgsrv high() {
        x = 1;
        self.high() after(1);
    }

    @priority(2)
    msgsrv low() {
        y = 1;
        self.low() after(1);
    }
}

main {
    Selector selector():();
}
