// Benchmark: multi-store--priority-selection--positive
// A multi-store source exercising priority selection: two ranked message servers enabled together, so declared priority decides which runs first.
reactiveclass Selector(10) {
    statevars {
        int x;
        int y;
    }

    Selector() {
        x = 0;
        y = 0;
        self.high() after(1);
        self.low() after(1);
    }

    @priority(1)
    msgsrv high() {
        x = 1;
        self.high() after(1);
    }

    @priority(2)
    msgsrv low() {
        y = 1;
        self.low() after(1);
    }
}

main {
    Selector selector():();
}
