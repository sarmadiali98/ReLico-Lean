// Benchmark: general--periodic-circular-composition--positive
// A DTR-fragment redesign of examples2 Periodic_Circular_Composition, whose original
// form overflows the model checker's queue; see README for the redesign.
reactiveclass Node(4) {
    knownrebecs {
        Node next;
    }
    statevars {
        int id;
    }
    Node(int _id) {
        id = _id;
        if (id == 0) {
            self.sendMsg(1);
        }
    }
    msgsrv sendMsg(int msg) {
        next.rcvMsg(msg);
    }
    msgsrv rcvMsg(int msg) {
        self.sendMsg(msg) after(1);
    }
}
main {
    Node node0(node1):(0);
    Node node1(node2):(1);
    Node node2(node3):(2);
    Node node3(node0):(3);
}
