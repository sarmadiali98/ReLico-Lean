target Cpp

reactor Boot {
  state x: int = 0
  state y: int = 0
  state z: int = 0
  logical action begin_action: void
  logical action step_action: void

  reaction(startup) -> begin_action {=
    x = 1;
    y = 2;
    z = 3;
    begin_action.schedule(1ms);
  =}

  reaction(begin_action) -> step_action {=
    x = y;
    step_action.schedule(1ms);
  =}

  reaction(step_action) -> begin_action {=
    y = z;
    z = x;
    begin_action.schedule(1ms);
  =}
}

main reactor {
  boot = new Boot()
}
