// Benchmark: multi-store--initialization--positive
// A multi-store source exercising initialization: the constructor establishes a three-variable store that the message servers then rotate.
reactiveclass Boot(10) {
    statevars {
        int x;
        int y;
        int z;
    }

    Boot() {
        x = 1;
        y = 2;
        z = 3;
        self.begin() after(1);
    }

    msgsrv begin() {
        x = y;
        self.step() after(1);
    }

    msgsrv step() {
        y = z;
        z = x;
        self.begin() after(1);
    }
}

main {
    Boot boot():();
}
