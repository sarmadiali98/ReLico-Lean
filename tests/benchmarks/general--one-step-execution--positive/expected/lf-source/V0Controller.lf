target Cpp

reactor Counter {
  state x: int = 0
  state violation: int = 0
  logical action tick_action1: void
  logical action tick_action2: void

  reaction(startup) -> tick_action1 {=
    x = 0;
    violation = 0;
    tick_action1.schedule(1ms);
  =}

  reaction(tick_action1) -> tick_action2 {=
    if ((x == 0)) { x = 1; } else { x = 0; }
    if ((x < 0)) { violation = 1; } else {}
    tick_action2.schedule(1ms);
  =}

  reaction(tick_action2) -> tick_action2 {=
    if ((x == 0)) { x = 1; } else { x = 0; }
    if ((x < 0)) { violation = 1; } else {}
    tick_action2.schedule(1ms);
  =}
}

main reactor {
  ctr = new Counter()
}
