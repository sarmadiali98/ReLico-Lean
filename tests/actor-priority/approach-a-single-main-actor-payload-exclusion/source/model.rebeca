// Benchmark: core--initialization--positive
// Exercises constructor initialization, delayed self-send, verified
// translation, LF/C++ generation, and bounded recurring execution.
reactiveclass Controller(10) {
    statevars {
        int x;
    }

    Controller() {
        x = 0;
        self.tick() after(1);
    }

    msgsrv tick() {
        x = x;
        self.tick() after(1);
    }

    msgsrv relcoPayload(int value) {
    }
}

main {
    @priority(1)
    Controller controller():();
}
