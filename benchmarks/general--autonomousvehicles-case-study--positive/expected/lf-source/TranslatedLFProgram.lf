  reaction(startup) {=
    crossIsFree = true;
  =}

  reaction(giveCrossPermission_action) -> getCrossPermissionToSegA, getCrossPermissionToSegB, crossNotAvailableToSegA, crossNotAvailableToSegB {=
    auto giveCrossPermission_action_payload = *giveCrossPermission_action.get();
    auto vehicleId = giveCrossPermission_action_payload.vehicleId;
    auto senderTag = giveCrossPermission_action_payload.senderTag;
    if (crossIsFree) { crossIsFree = false; if ((senderTag == 0)) { getCrossPermissionToSegA.set(vehicleId); } else { getCrossPermissionToSegB.set(vehicleId); } } else { if ((senderTag == 0)) { crossNotAvailableToSegA.set(vehicleId); } else { crossNotAvailableToSegB.set(vehicleId); } }
  =}

