// Benchmark: general--autonomousvehicles-case-study--positive
// The paper-named AutonomousVehicles model, redesigned for the DTR
// fragment: rebec-typed routing state became knownrebec bindings plus
// kind tags, sender-reply became tag-parameterised static dispatch, the
// null-terminated segment topology became nextKind tags over full
// bindings, the CrossController round-trip became a two-binding tag
// dispatch, computed delays became literal branches over the two
// speeds, and the all-vehicles-arrived assertion became an
// allVehiclesReached latch. See ADAPTATION.md for the full mapping.

reactiveclass CrossController(10) {
    knownrebecs {
        Segment segA;
        Segment segB;
    }
    statevars {
        boolean crossIsFree;
    }
    CrossController() {
        crossIsFree = true;
    }
    msgsrv giveCrossPermission(int vehicleId, int senderTag) {
        if (crossIsFree) {
            crossIsFree = false;
            if (senderTag == 0) {
                segA.getCrossPermission(vehicleId);
            } else {
                segB.getCrossPermission(vehicleId);
            }
        } else {
            if (senderTag == 0) {
                segA.crossNotAvailable(vehicleId);
            } else {
                segB.crossNotAvailable(vehicleId);
            }
        }
    }
    msgsrv freeCross(int vehicleId) {
        crossIsFree = true;
    }
}

reactiveclass PrimaryCrusher (14) {
    knownrebecs {
        Segment firstSubSegPcToSc;
        Segment requester;
    }
    statevars {
        boolean isLoading;
    }
    PrimaryCrusher() {
        isLoading = false;
    }
    msgsrv givePermisionForVehicle(int vehicleId) {
        if (isLoading == false) {
            isLoading = true;
            requester.getPermision(vehicleId);
        } else {
            requester.segmentNotFree(vehicleId);
        }
    }
    msgsrv vehicleEntered(int vehicleId){
        self.startSendingToNext(vehicleId) after(60);
    }
    msgsrv startSendingToNext(int vehicleId){
        firstSubSegPcToSc.givePermisionForVehicle(vehicleId, -1, 0);
    }
    msgsrv getPermision (int vehicleId){
        isLoading = false;
        requester.vehicleEntered(vehicleId);
    }
    msgsrv segmentNotFree (int vehicleId){
        self.startSendingToNext(vehicleId) after(25);
    }
}

reactiveclass SecondaryCrusher (14) {
    knownrebecs {
        Segment firstSubSegScToPrepoint;
        Segment requester;
    }
    statevars {
        boolean isUnloading;
    }
    SecondaryCrusher() {
