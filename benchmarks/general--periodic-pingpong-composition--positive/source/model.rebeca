// Benchmark: general--periodic-pingpong-composition--positive
// A DTR-fragment redesign of examples2 Periodic_PingPong_Composition, whose original
// form overflows the model checker's queue; see README for the redesign.
reactiveclass Node(4) {
    knownrebecs {
        Node next;
    }
    statevars {
        int id;
    }
    Node(int _id) {
        id = _id;
        self.sendMsg(1);
    }
    @priority(1)
    msgsrv sendMsg(int msg) {
        next.rcvMsg(msg);
    }
    @priority(2)
    msgsrv rcvMsg(int msg) {
        next.sendMsg(msg) after(1);
    }
}
main {
    Node node0(node1):(0);
    Node node1(node0):(1);
}
