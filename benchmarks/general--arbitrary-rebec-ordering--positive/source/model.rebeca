// Benchmark: general--arbitrary-rebec-ordering--positive
// A DTR-fragment redesign of examples2 Arbitrary_Ordering_Rebec, whose original
// form overflows the model checker's queue; see README for the redesign.
reactiveclass Sender(4) {
    knownrebecs {
        receiver recv0;
        receiver recv1;
        receiver recv2;
        receiver recv3;
    }
    statevars {
        int resolved;
    }
    Sender() {
        resolved = 0;
        self.sendMsg(1);
    }
    msgsrv sendMsg(int msg) {
        recv0.rcvMsg(msg);
        recv1.rcvMsg(msg);
        recv2.rcvMsg(msg);
        recv3.rcvMsg(msg);
    }
    msgsrv ack(int from) {
        resolved = resolved + 1;
        if (resolved == 4) {
            resolved = 0;
            self.sendMsg(1) after(1);
        }
    }
}
reactiveclass receiver(4) {
    knownrebecs {
        Sender origin;
    }
    statevars{
        int id;
    }
    receiver(int _id){
        id = _id;
    }
    msgsrv rcvMsg(int msg) {
        origin.ack(id);
    }
}
main {
  receiver receiver0(sender1):(0);
  receiver receiver1(sender1):(1);
  receiver receiver2(sender1):(2);
  receiver receiver3(sender1):(3);
  Sender sender1(receiver0, receiver1, receiver2, receiver3):();
}
