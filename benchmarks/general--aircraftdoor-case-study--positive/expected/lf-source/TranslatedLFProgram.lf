target Cpp

reactor Monitor {
  input observeDoorToMFromDoor: int
  state violation: int = 0
  logical action observeDoor_action: int

  reaction(startup) {=
    violation = 0;
  =}

  reaction(observeDoor_action) {=
    auto doorValue = *observeDoor_action.get();
    if ((doorValue != 1)) { violation = 1; } else {}
  =}

  reaction(observeDoorToMFromDoor) {=
    auto doorValue = *observeDoorToMFromDoor.get();
    if ((doorValue != 1)) { violation = 1; } else {}
  =}
}

reactor Door {
  input setDoorToDoor1FromVision: int
  input setDoorToDoor2FromVision: int
  output observeDoorToM: int
  state doorOpen: int = 0
  logical action setDoor_action: int

  reaction(startup) {=
    doorOpen = 0;
  =}

  reaction(setDoor_action) -> observeDoorToM {=
    auto v = *setDoor_action.get();
    if ((v == 1)) { doorOpen = 1; } else { if ((v == 0)) { doorOpen = 0; } else {} }
    observeDoorToM.set(doorOpen);
  =}

  reaction(setDoorToDoor1FromVision) -> observeDoorToM {=
    auto v = *setDoorToDoor1FromVision.get();
    if ((v == 1)) { doorOpen = 1; } else { if ((v == 0)) { doorOpen = 0; } else {} }
    observeDoorToM.set(doorOpen);
  =}

  reaction(setDoorToDoor2FromVision) -> observeDoorToM {=
    auto v = *setDoorToDoor2FromVision.get();
    if ((v == 1)) { doorOpen = 1; } else { if ((v == 0)) { doorOpen = 0; } else {} }
    observeDoorToM.set(doorOpen);
  =}
}

reactor Vision {
  input inputToVisionFromController: int
  output setDoorToDoor1: int
  output setDoorToDoor2: int
  state ramp: int = 0
  logical action input_action: int

  reaction(startup) {=
    ramp = 0;
  =}

  reaction(input_action) -> setDoorToDoor1, setDoorToDoor2 {=
    auto v = *input_action.get();
    if ((ramp == 1)) { setDoorToDoor1.set(0); } else { setDoorToDoor2.set(1); }
  =}

  reaction(inputToVisionFromController) -> setDoorToDoor1, setDoorToDoor2 {=
    auto v = *inputToVisionFromController.get();
    if ((ramp == 1)) { setDoorToDoor1.set(0); } else { setDoorToDoor2.set(1); }
  =}
}

reactor KeepAlive {
  input kickToKaFromController: int
  state phase: int = 0
  logical action kick_action: int
  logical action tick_action1: void
  logical action tick_action2: void

  reaction(startup) {=
    phase = 0;
  =}

  reaction(kick_action) -> tick_action1 {=
    auto unit = *kick_action.get();
    tick_action1.schedule(1000ms);
  =}

  reaction(kickToKaFromController) -> tick_action1 {=
    auto unit = *kickToKaFromController.get();
    tick_action1.schedule(1000ms);
  =}

  reaction(tick_action1) -> tick_action2 {=
    if ((phase == 0)) { phase = 1; } else { phase = 0; }
    tick_action2.schedule(1000ms);
  =}

  reaction(tick_action2) -> tick_action2 {=
    if ((phase == 0)) { phase = 1; } else { phase = 0; }
    tick_action2.schedule(1000ms);
  =}
}

reactor Controller {
  output inputToVision: int
  output kickToKa: int
  logical action start_action: void

  reaction(startup) -> start_action {=
    start_action.schedule(0ms);
  =}

  reaction(start_action) -> inputToVision, kickToKa {=
    inputToVision.set(1);
    kickToKa.set(0);
  =}
}

main reactor {
  controller = new Controller()
  vision = new Vision()
  door = new Door()
  m = new Monitor()
  ka = new KeepAlive()
  controller.inputToVision -> vision.inputToVisionFromController after 0 msec
  controller.kickToKa -> ka.kickToKaFromController after 0 msec
  vision.setDoorToDoor1 -> door.setDoorToDoor1FromVision after 0 msec
  vision.setDoorToDoor2 -> door.setDoorToDoor2FromVision after 0 msec
  door.observeDoorToM -> m.observeDoorToMFromDoor after 0 msec
}
