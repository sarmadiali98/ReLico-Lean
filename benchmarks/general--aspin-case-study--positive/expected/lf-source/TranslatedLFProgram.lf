  output get_AckToW2: Router_get_Ack_action_Args
  output resetToManager: int
  state bufSize: int = 0
  state maxTime: int = 0
  state recieved: int = 0
  state bufNum0: int = 0
  state bufNum1: int = 0
  state bufNum2: int = 0
  state bufNum3: int = 0
  state full0: bool = false
  state full1: bool = false
  state full2: bool = false
  state full3: bool = false
  state enable0: bool = false
  state enable1: bool = false
  state enable2: bool = false
  state enable3: bool = false
  state outMutex0: bool = false
  state outMutex1: bool = false
  state outMutex2: bool = false
  state outMutex3: bool = false
  state Xid: int = 0
  state Yid: int = 0
  state deadlineViolation: bool = false
  logical action reqSend_action1: Router_reqSend_action1_Args
  logical action reqSend_action2: Router_reqSend_action2_Args
  logical action reqSend_action3: Router_reqSend_action3_Args
  logical action reqSend_action4: Router_reqSend_action4_Args
  logical action reqSend_action5: Router_reqSend_action5_Args
  logical action reqSend_action6: Router_reqSend_action6_Args
  logical action reqSend_action7: Router_reqSend_action7_Args
