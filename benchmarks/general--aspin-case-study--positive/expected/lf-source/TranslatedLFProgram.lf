  logical action give_Ack_action: Router_give_Ack_action_Args
  logical action reStart_action: int
  logical action checkPoint_action: void
  logical action checkRecieved_action: void

  reaction(startup) -> reqSend_action1, reStart_action, checkRecieved_action {=
    Xid = X;
    Yid = Y;
    bufSize = 2;
    maxTime = 250;
    recieved = 0;
    deadlineViolation = false;
    enable0 = true;
    enable1 = true;
    enable2 = true;
    enable3 = true;
    outMutex0 = true;
    outMutex1 = true;
    outMutex2 = true;
    outMutex3 = true;
    bufNum0 = 0;
    bufNum1 = 0;
    bufNum2 = 0;
    bufNum3 = 0;
    full0 = false;
    full1 = false;
    full2 = false;
    full3 = false;
    if (((X == 0) && (Y == 0))) { reqSend_action1.schedule(Router_reqSend_action1_Args{2, 3, 1, 5}, 10ms); } else {}
    if (((X == 0) && (Y == 1))) { reStart_action.schedule(0, 700ms); } else {}
    if (((X == 2) && (Y == 3))) { checkRecieved_action.schedule(250ms); } else {}
  =}

  reaction(reqSend_action1) -> give_AckToE, reqSend_action2, give_AckToW, reqSend_action3, give_AckToS, reqSend_action4, give_AckToN, reqSend_action5, reqSend_action6 {=
    auto reqSend_action1_payload = *reqSend_action1.get();
    auto Xtarget = reqSend_action1_payload.Xtarget;
    auto Ytarget = reqSend_action1_payload.Ytarget;
    auto directionS = reqSend_action1_payload.directionS;
    auto packId = reqSend_action1_payload.packId;
