// Benchmark: general--periodic-sequential-composition--positive
// A DTR-fragment redesign of examples2 Periodic_Sequential_Composition, whose original
// form overflows the model checker's queue; see README for the redesign.
reactiveclass Node(4) {
    knownrebecs {
        Node next;
    }
    statevars {
        boolean islast;
        int id;
    }
    Node(boolean _islast, int _id){
        id = _id;
        islast = _islast;
        if(!islast){
            self.sendMsg(1);
        }
    }
    @priority(1)
    msgsrv sendMsg(int msg) {
        next.rcvMsg(msg);
    }
    @priority(2)
    msgsrv rcvMsg(int msg) {
        if(islast) {
            self.sendMsg(1) after(1);
        } else {
            next.sendMsg(msg) after(1);
        }
    }
}
main {
    Node node0(node1):(false, 0);
    Node node1(node2):(false, 1);
    Node node2(node3):(false, 2);
    Node node3(node3):(true, 3);
}
