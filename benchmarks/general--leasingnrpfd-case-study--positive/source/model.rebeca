// Node Modes

// for testing





reactiveclass Node (4){

    knownrebecs {
    	Switch out1, out2;
    }
   
    statevars {
           int nodeMode;
           int id;
           int NRPCandidates0;
           int NRPCandidates1;
           int heartbeats_missed_1;
           int heartbeats_missed_2;
           int NRP_network;
           int attacker;
           int which;
           boolean prevWhich;
           int NRP_switch_id;
           boolean NRP_pending;
           boolean become_primary_on_ping_response;  
           int primary;
           boolean ping_pending;
           boolean init;
    }
    Node (int Myid, int Myprimary, int NRPCan1_id, int NRPCan2_id, int myFailTime) {
           id = Myid;
           attacker = 0;
           which=0;
           prevWhich=true;
		   NRPCandidates0 =NRPCan1_id;
		   NRPCandidates1 =NRPCan2_id;	
           heartbeats_missed_1 = 0;
           heartbeats_missed_2 = 0;
           NRP_network = -1;
           NRP_switch_id = -1;
           NRP_pending = true;
           become_primary_on_ping_response = false;
           primary = Myprimary;
           ping_pending = false;
           init=true;
           
           nodeMode = 0;
           if (myFailTime == 2500) self.nodeFail() after(2500);
           else if (myFailTime == 5000) self.nodeFail() after(5000);
           self.runMe();
    }
	
    msgsrv new_NRP_request_timed_out() {
//      if(?(true,false)) nodeFail();
	  	if (nodeMode == 2) {
           if (NRP_pending) {
	          NRP_pending = false;
	          if (become_primary_on_ping_response) 
	             become_primary_on_ping_response = false;
    	   }
        }
	}
	  
	  // logical action ping_timed_out(ping_timeout)
    msgsrv ping_timed_out() {
//      if(?(true,false)) nodeFail();
	  	if (nodeMode == 2) {
           if (ping_pending) ping_pending = false;
	       else{
	            if(which>1){
	        	   nodeMode = 1;
        	       heartbeats_missed_1 = 0; 
	               heartbeats_missed_2 = 0;
	               primary=id;
				   if(NRP_network==0) out1.new_NRPBack(id, id,NRP_network, NRP_switch_id);
				   else out2.new_NRPBack(id,id, NRP_network, NRP_switch_id);
	        	   nodeMode = 1;
        	       heartbeats_missed_1 = 0; 
	               heartbeats_missed_2 = 0;
	               primary=id;
	               NRP_pending = true;
	            }else NRP_pending = true;
	        }
	     }else if (nodeMode == 1){
                  if (ping_pending) {
                         ping_pending = false;
	                 NRP_network = NRP_network + 1;
				     if(NRP_network<2){
				        if (NRP_network == 0) NRP_switch_id = NRPCandidates0; else NRP_switch_id = NRPCandidates1;
				        if(NRP_network==0) out1.new_NRP(id, id,NRP_network, NRP_switch_id);
				        else out2.new_NRP(id,id, NRP_network, NRP_switch_id);
				     } else {
				         NRP_network=2;
				         nodeMode=  0;
				     }  
	                 NRP_pending = true;
	              } else{
	                   if(attacker<1){
			     	   out1.heartBeat(0, id) after(1);
                       out2.heartBeat(1, id) after(1);
                  }
	      }
	        
       }
    }
	  	  
	  
    msgsrv pingNRP_response(int mid, boolean w, boolean pw){
//      if(?(true,false)) nodeFail();
       if (nodeMode == 2){
        	   if(!w && !pw) which = which + 1;
        	   else which=0;
               if(which>1)
               ping_pending = false;
        	 }
             else if (nodeMode == 1) 
                     ping_pending = false;
    }
	  
    msgsrv new_NRP(int mid,int prim, int mNRP_network, int mNRP_switch_id) {
//      if(?(true,false)) nodeFail();
        if(nodeMode!= 3){
    	    NRP_network = mNRP_network;
	        NRP_switch_id = mNRP_switch_id;
        }
    }
    msgsrv new_NRPBack(int mid,int prim, int mNRP_network, int mNRP_switch_id) {
//      if(?(true,false)) nodeFail();
        if(nodeMode!= 3){
	       NRP_network = mNRP_network;
	       NRP_switch_id = mNRP_switch_id;
	    }
    }
    
      msgsrv runMe(){ 
                if (nodeMode == 0) {
 //WAITING : 
                      if(init){
				         if (id == primary){
				             nodeMode = 1;
				             NRP_network = NRP_network + 1;
				             if(NRP_network<2){
				                if (NRP_network == 0) NRP_switch_id = NRPCandidates0; else NRP_switch_id = NRPCandidates1;
				                if(NRP_network==0)out1.new_NRP(id,id, NRP_network, NRP_switch_id);
				                else out2.new_NRP(id,id, NRP_network, NRP_switch_id);
				             } else NRP_network=2;
				         } else nodeMode =2;
           			     init=false;
           			  }	 
        }
        else if (nodeMode == 1) {
 //PRIMARY : 
                      attacker = attacker + 1;
                      if(attacker>1) attacker=1;
            		  if (!ping_pending) {
            		  if(NRP_network==0){	
    	               	 ping_pending = true;
            			 out1.pingNRP(id,id, NRP_switch_id) after(5);
            			 self.ping_timed_out() after(100);
            		   }else{
        	               ping_pending = true;
                 		   out2.pingNRP(id,id, NRP_switch_id) after(5);
                 		   self.ping_timed_out() after(100);
            		   }
            		  }
	                   NRP_pending = true;
        }
        else if (nodeMode == 2) {
 //BACKUP : 
            			heartbeats_missed_1 = heartbeats_missed_1 + 1;
	        			heartbeats_missed_2 = heartbeats_missed_2 + 1;
            			if (heartbeats_missed_1 > 2	&& heartbeats_missed_2 > 2){
                            if (heartbeats_missed_1 > 2+2) { heartbeats_missed_1 = 2+2; }
                            if (heartbeats_missed_2 > 2+2) { heartbeats_missed_2 = 2+2; }
//								   if(heartbeats_missed_1==heartbeats_missed_2 && heartbeats_missed_2==max_missed_heartbeats+1){
//		          				
//		          				   nodeMode = PRIMARY;
//        	      				   heartbeats_missed_1 = 0; // Prevent detecting again immediately.
//	              				   heartbeats_missed_2 = 0;
//	              				   primary=id;
//	                               NRP_pending = true;
//	              				}else{
							if (!ping_pending) {
							if(NRP_network==0){	
    	            		   ping_pending = true;
	            			  //NRP_network=-1;
            				   out1.pingNRP(id,id, NRP_switch_id) after(15);
            				   self.ping_timed_out() after(100);
            				}else{
        	            	   ping_pending = true;
							   //NRP_network=-1;	                 				      
                 			   out2.pingNRP(id,id, NRP_switch_id) after(15);
                 			   self.ping_timed_out() after(100);
            				 }
							}
	                         NRP_pending = true;
//	              				}
	              		}else if(heartbeats_missed_1 > 2|| heartbeats_missed_2 > 2){
                    			 if (!ping_pending) {
                    			 if(NRP_network==0 && heartbeats_missed_1 > 2) {
            				        ping_pending = true;
            				        out1.pingNRP(id,id, NRP_switch_id) after(5);
            				        self.ping_timed_out() after(100);
            				     }else if(NRP_network==1 && heartbeats_missed_2 > 2){
            				              ping_pending = true;
            				              out2.pingNRP(id,id, NRP_switch_id) after(5);
            				              self.ping_timed_out() after(100);
            				            }
                    			 }
                                  if (heartbeats_missed_1 > 2+2) { heartbeats_missed_1 = 2+2; }
                                  if (heartbeats_missed_2 > 2+2) { heartbeats_missed_2 = 2+2; }
            			}
        }
        else if (nodeMode == 3) {
 //FAILED : 
        } 
        self.runMe() after(1000);
     }
     
     msgsrv heartBeat(int networkId, int senderid) {
//      if(?(true,false)) nodeFail();
     	if (nodeMode==2){
            if (networkId == 0) heartbeats_missed_1 = 0;
            else heartbeats_missed_2 = 0;
        } 
     }
     msgsrv nodeFail(){
        primary=-1;
        nodeMode = 3;
        NRP_network=-1;
        NRP_switch_id=-1;
        heartbeats_missed_1 = 0;
        heartbeats_missed_2 = 0;
        NRP_pending = true;
        become_primary_on_ping_response = false;
        ping_pending = false;
     }
   
}
    

reactiveclass Switch(10){
    knownrebecs {
       Node nodeTarget1;
       Switch up;
       Switch down;
    }
    statevars {
    	int mynetworkId;
    	int id;
    	boolean which;
    	boolean prevWhich;
    	boolean failed;
    	boolean amINRP;
    	boolean primaryPinged;
    	boolean terminal;
    	int primary;
    }
    Switch (int myid, int networkId, boolean endSwitch, int myFailTime) {
       mynetworkId = networkId;
       primary=0;
       id = myid;
       primaryPinged=false;
       terminal=endSwitch;
       amINRP = false;
       failed = false;
       which=true;
       if (myFailTime == 2500) self.switchFail() after(2500);
       else if (myFailTime == 5000) self.switchFail() after(5000);
    }
    
    msgsrv switchFail(){
       failed = true;
       amINRP=false;
    }
   
    msgsrv pingNRP_response(int senderNode,boolean w,boolean pw){
//      if(?(true,false)) switchFail();
      if(!failed)
          if(terminal && senderNode <= 99) nodeTarget1.pingNRP_response(id, w,pw); //Pass back
          else if(senderNode >id) up.pingNRP_response(id, w,pw);
               else down.pingNRP_response(id, w,pw);
    }
    
    msgsrv pingNRP(int switchNode, int senderNode, int NRP) {
//      if(?(true,false)) switchFail();
      if(!failed)
        if(terminal && NRP==id){
           prevWhich = which;
           which= (senderNode==primary);
           if(switchNode <= 99) up.pingNRP_response(id,which, prevWhich); //Response
           else nodeTarget1.pingNRP_response(id,which, prevWhich);
        }else if(switchNode >id) up.pingNRP(id,senderNode,NRP); 
              else down.pingNRP(id,senderNode, NRP);
    }
    
    msgsrv new_NRP(int senderNode,int prim, int mNRP_network, int mNRP_switch_id) {
//      if(?(true,false)) switchFail();
      if(!failed){
         if(id==mNRP_switch_id) {
            amINRP=true;
            primary=prim;
         } else amINRP=false;
         if(terminal && senderNode <= 99)nodeTarget1.new_NRP(id,prim, mNRP_network, mNRP_switch_id);
         else if(senderNode >id) up.new_NRP(id,prim, mNRP_network, mNRP_switch_id); //Pass back
               else down.new_NRP(id,prim, mNRP_network, mNRP_switch_id);
       }
    }
    
    msgsrv new_NRPBack(int senderNode,int prim, int mNRP_network, int mNRP_switch_id) {
//      if(?(true,false)) switchFail();
      if(!failed){
         if(id==mNRP_switch_id) {
            amINRP=true;
            primary=prim;
         } else amINRP=false;
         if(terminal && senderNode <= 99)nodeTarget1.new_NRPBack(id,prim, mNRP_network, mNRP_switch_id);
         else if(senderNode >id) up.new_NRPBack(id,prim, mNRP_network, mNRP_switch_id); //Pass back
              else down.new_NRPBack(id,prim, mNRP_network, mNRP_switch_id);
       }
    }
    
    msgsrv heartBeat(int networkId, int senderNode) {
//      if(?(true,false)) switchFail();
      if(!failed)
         if(terminal && senderNode <= 99) nodeTarget1.heartBeat(networkId,id) after(1);
         else if(senderNode > id) up.heartBeat(networkId,id) after(1);
              else down.heartBeat(networkId,id) after(1);
    }
}

main {
    @priority(1) Switch switchA1(DCN1, switchA2, switchA2):(1, 0, true, 2500);

    @priority(1) Switch switchA2(DCN1, switchA1, switchA3):(2, 0, false, 2500);

    @priority(1) Switch switchA3(DCN2, switchA2, switchA2):(3, 0, true, 0);

    @priority(1) Switch switchB1(DCN1, switchB2, switchB2):(4, 1, true, 2500);

    @priority(1) Switch switchB2(DCN1, switchB1, switchB3):(5, 1, false, 2500);

    @priority(1) Switch switchB3(DCN2, switchB2, switchB2):(6, 1, true, 0);

	@priority(2) Node DCN1(switchA1, switchB1):(100, 100, 1, 4, 0);
	@priority(2) Node DCN2(switchA3, switchB3):(101, 100, 3, 6, 0);
}
