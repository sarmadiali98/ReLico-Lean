target Cpp

reactor Coordinator {
  state round: int = 0
  state seen: int = 0
  state violation: int = 0
  logical action start_action: void
  logical action dispatch_action1: void
  logical action dispatch_action2: void
  logical action token_action1: void
  logical action token_action2: void
  logical action token_action3: void
  logical action token_action4: void
  logical action token_action5: void
  logical action token_action6: void
  logical action token_action7: void
  logical action token_action8: void
  logical action token_action9: void
