target Cpp

reactor Source {
  output kickToKa: int
  output inputNToF: int
  logical action start_action: void

  reaction(startup) -> start_action {=
    start_action.schedule(0ms);
  =}

  reaction(start_action) -> kickToKa, inputNToF {=
    kickToKa.set(0);
    inputNToF.set(4);
  =}
}

reactor FactorialCore {
  input inputNToFFromSrc: int
  output completeToChk: int
  logical action inputN_action: int
  logical action complete_action1: int
  logical action complete_action2: int

  reaction(inputN_action) -> complete_action1, complete_action2 {=
    auto n = *inputN_action.get();
    if ((n == 4)) { complete_action1.schedule(24, 10ms); } else { complete_action2.schedule(0, 10ms); }
  =}

  reaction(inputNToFFromSrc) -> complete_action1, complete_action2 {=
    auto n = *inputNToFFromSrc.get();
    if ((n == 4)) { complete_action1.schedule(24, 10ms); } else { complete_action2.schedule(0, 10ms); }
  =}

  reaction(complete_action1) -> completeToChk {=
    auto v = *complete_action1.get();
    completeToChk.set(v);
  =}

  reaction(complete_action2) -> completeToChk {=
    auto v = *complete_action2.get();
    completeToChk.set(v);
  =}
}

reactor Checker {
  input completeToChkFromF: int
  state violation: int = 0
  logical action complete_action: int

  reaction(startup) {=
    violation = 0;
  =}

  reaction(complete_action) {=
    auto v = *complete_action.get();
    if ((v != 24)) { violation = 1; } else {}
  =}

  reaction(completeToChkFromF) {=
    auto v = *completeToChkFromF.get();
    if ((v != 24)) { violation = 1; } else {}
  =}
}

reactor KeepAlive {
  input kickToKaFromSrc: int
  state phase: int = 0
  logical action kick_action: int
  logical action tick_action1: void
  logical action tick_action2: void

  reaction(startup) {=
    phase = 0;
  =}

  reaction(kick_action) -> tick_action1 {=
    auto unit = *kick_action.get();
    tick_action1.schedule(100ms);
  =}

  reaction(kickToKaFromSrc) -> tick_action1 {=
    auto unit = *kickToKaFromSrc.get();
    tick_action1.schedule(100ms);
  =}

  reaction(tick_action1) -> tick_action2 {=
    if ((phase == 0)) { phase = 1; } else { phase = 0; }
    tick_action2.schedule(100ms);
  =}

  reaction(tick_action2) -> tick_action2 {=
    if ((phase == 0)) { phase = 1; } else { phase = 0; }
    tick_action2.schedule(100ms);
  =}
}

main reactor {
  src = new Source()
  f = new FactorialCore()
  chk = new Checker()
  ka = new KeepAlive()
  src.kickToKa -> ka.kickToKaFromSrc after 0 msec
  src.inputNToF -> f.inputNToFFromSrc after 0 msec
  f.completeToChk -> chk.completeToChkFromF after 0 msec
}
