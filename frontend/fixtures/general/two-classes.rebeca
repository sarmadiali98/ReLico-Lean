reactiveclass Producer(3) {
    knownrebecs {
        Consumer sink;
    }
    statevars {
        int sent;
    }
    Producer() {
        sent = 0;
        self.tick();
    }
    msgsrv tick() {
        sent = sent + 1;
        sink.accept(sent);
    }
}

reactiveclass Consumer(2) {
    statevars {
        int total;
    }
    Consumer() {
        total = 0;
    }
    @priority(1)
    msgsrv accept(int amount) {
        total = total + amount;
    }
}

main {
    Producer producer0(consumer0):();
    Consumer consumer0():();
}
