reactiveclass Consumer(2) {
    msgsrv accept(int value) {
    }
}

reactiveclass Producer(3) {
    knownrebecs {
        Consumer sink;
    }
    statevars {
        int held;
    }
    msgsrv tick() {
        held = sink;
    }
}

main {
    Producer producer0(consumer0):();
    Consumer consumer0():();
}
