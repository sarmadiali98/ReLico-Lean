{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReLico benchmark stage result",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_id",
    "stage",
    "status",
    "exit_code",
    "duration_ms",
    "command"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "timeout",
        "not-run"
      ]
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
